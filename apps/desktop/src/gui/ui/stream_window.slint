import { SurfaceSeparator, FlatSurface, UiSurface } from "ui_surface.slint";
import { UiRadius } from "ui_radius.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";
import { RemoteCursor } from "remote_cursor.slint";
import { FontAwesomeIcons, IconButton, PrimaryButton, SecondaryButton, DialogSurface, ImGuiFontStyle, ControlStyle, ButtonStyle, ScrollingText } from "common.slint";

export struct StreamTab {
    remote-id: string,
    title: string,
    connected: bool,
}

export struct FileTransferEntry {
    name: string,
    status: string,
    progress: float,
    speed: string,
    size: string,
}

export struct NetworkStatsRow {
    label: string,
    inbound: string,
    outbound: string,
    loss-rate: string,
}

