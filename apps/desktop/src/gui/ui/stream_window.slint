    in-out property <string> select-display: "Select Display";
    in-out property <string> send-shortcut: "Send Shortcut";
    in-out property <string> privacy-unlocked-title: "Privacy screen unlocked";
    in-out property <string> privacy-unlocked-message: "The remote privacy screen was unlocked using the local shortcut. Lock it again to restore privacy and disable local shortcut unlocking.";
    in-out property <string> privacy-unlock-confirm: "Confirm";
    in-out property <string> privacy-unlock-lock: "Lock";
    in-out property <string> privacy-enable: "Enable privacy screen";
