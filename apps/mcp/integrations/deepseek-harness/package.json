{
  "name": "@chunkdash/dsh-crossdesk-sidebar",
  "version": "0.1.0",
  "description": "Open CrossDesk remote desktop panels in DeepSeek Harness Desktop's sidebar",
  "type": "module",
  "main": "dist/host.js",
  "exports": { ".": "./dist/host.js", "./client": "./dist/client.js", "./package.json": "./package.json" },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-sidebar-browser"],
      "platform": "web"
    }
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "license": "GPL-3.0-only"
}
