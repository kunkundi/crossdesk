{
  "name": "@chunkdash/crossdesk-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local CrossDesk MCP tools and remote desktop panels",
  "license": "GPL-3.0-only",
  "author": "DI JUNKUN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunkundi/crossdesk.git",
    "directory": "apps/mcp"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "main": "dist/harness.js",
  "exports": {
    ".": "./dist/harness.js",
    "./client": "./dist/harness-client.js",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "dsh": {
    "bundle": { "patch": "cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-sidebar-browser"],
      "platform": "web"
    }
  },
  "bin": {
    "crossdesk-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && node scripts/build-harness.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "pack:npm": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
