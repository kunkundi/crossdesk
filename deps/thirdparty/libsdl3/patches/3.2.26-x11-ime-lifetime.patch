+static void X11_InputMethodDestroyed(XIM im, XPointer client_data, XPointer call_data)
+{
+    SDL_VideoData *data = (SDL_VideoData *)client_data;
+    /* Xlib has invalidated the IM and its contexts. They must not be used
+     * or closed again when the input method exits before SDL does. */
+    data->im = NULL;
+}
+
+static void X11_InputContextDestroyed(XIC ic, XPointer client_data, XPointer call_data)
+{
+    SDL_WindowData *data = (SDL_WindowData *)client_data;
+    data->ic = NULL;
+}
